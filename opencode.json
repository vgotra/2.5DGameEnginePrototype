{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "instructions": [
    ".agents/context/*.md"
  ],
  "mcp": {
    "vulkan": {
      "type": "local",
      "command": ["node", "tools/mcp/mcp-Vulkan/vulkan/build/index.js"],
      "enabled": true,
      "timeout": 30000
    },
    "renderdoc": {
      "type": "local",
      "command": ["uvx", "--python", "3.13", "--with", "mcp>=1.0,<2", "renderdoc-mcp"],
      "enabled": true,
      "timeout": 120000
    },
    "mcp-repo-graph": {
      "type": "local",
      "command": ["uvx", "--python", "3.13", "--with", "mcp>=1.0,<2", "mcp-repo-graph", "--repo", "."],
      "enabled": true,
      "timeout": 120000
    },
    "csharp": {
      "type": "local",
      "command": ["dotnet", "run", "--no-build", "--project", "tools/mcp/csharp-language-server/src/CsharpMcp"],
      "enabled": true,
      "timeout": 120000
    },
    "dotnet": {
      "type": "local",
      "command": ["dotnet", "dnx", "Community.Mcp.DotNet@1.*", "--yes"],
      "enabled": true,
      "timeout": 120000
    }
  }
}
