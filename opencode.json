{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "instructions": [
    ".agents/context/*.md"
  ],
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 20000
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "vulkan": {
      "type": "local",
      "command": ["node", "tools/mcp/mcp-Vulkan/vulkan/build/index.js"],
      "enabled": true,
      "timeout": 30000
    },
    "mcp-repo-graph": {
      "type": "local",
      "command": ["uvx", "--python", "3.13", "--with", "mcp>=1.0,<2", "mcp-repo-graph", "--repo", "."],
      "enabled": true,
      "timeout": 120000
    }
  }
}
