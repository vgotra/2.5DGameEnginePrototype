<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><AssemblyName>IsometricSandbox</AssemblyName></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Engine.App\Engine.App.csproj" />
    <ProjectReference Include="..\..\src\Engine.Assets\Engine.Assets.csproj" />
    <ProjectReference Include="..\..\src\Engine.Core\Engine.Core.csproj" />
    <ProjectReference Include="..\..\src\Engine.Mathematics\Engine.Mathematics.csproj" />
    <ProjectReference Include="..\..\src\Engine.Ecs\Engine.Ecs.csproj" />
    <ProjectReference Include="..\..\src\Engine.Platform.Desktop\Engine.Platform.Desktop.csproj" />
    <ProjectReference Include="..\..\src\Engine.Rendering.Vulkan\Engine.Rendering.Vulkan.csproj" />
    <ProjectReference Include="..\..\src\Engine.Threading\Engine.Threading.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\assets\textures\*.png">
      <Link>textures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\assets\fonts\splash-font.png">
      <Link>textures\splash-font.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Target Name="BuildGeneratedGameAssets" BeforeTargets="BeforeBuild" Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\BuildGeneratedGameAssets.ps1')">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\BuildGeneratedGameAssets.ps1&quot; -OutputDirectory &quot;$(OutputPath)assets&quot;" />
  </Target>
</Project>
