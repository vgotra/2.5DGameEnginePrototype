{
  "mcpServers": {
    "vulkan": {
      "command": "node",
      "args": ["tools/mcp/mcp-Vulkan/vulkan/build/index.js"]
    },
    "renderdoc": {
      "command": "uvx",
      "args": ["--python", "3.13", "--with", "mcp>=1.0,<2", "renderdoc-mcp"]
    },
    "mcp-repo-graph": {
      "command": "uvx",
      "args": ["--python", "3.13", "--with", "mcp>=1.0,<2", "mcp-repo-graph", "--repo", "."]
    },
    "csharp": {
      "command": "dotnet",
      "args": ["run", "--no-build", "--project", "tools/mcp/csharp-language-server/src/CsharpMcp"]
    },
    "dotnet": {
      "command": "dotnet",
      "args": ["dnx", "Community.Mcp.DotNet@1.*", "--yes"]
    }
  }
}
